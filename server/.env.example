# Sao chép file này thành .env rồi chỉnh nếu cần. Tất cả đều tùy chọn.

# Cổng và địa chỉ nghe. 127.0.0.1 = chỉ máy này truy cập được (an toàn cho server offline).
# Đổi thành 0.0.0.0 nếu muốn máy khác trong mạng LAN dùng chung.
PORT=4000
HOST=127.0.0.1

# Tài khoản admin đầu tiên (chỉ dùng lần chạy đầu khi chưa có admin).
# Nếu bỏ trống mật khẩu, server tạo mật khẩu ngẫu nhiên và in ra màn hình + lưu data/ADMIN_ACCOUNT.txt
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Khóa ký đăng nhập. Bỏ trống thì tự tạo và lưu ở data/jwt.secret
# JWT_SECRET=

# Múi giờ để tính "doanh thu hôm nay" (Hàn Quốc = 9, Việt Nam = 7)
TZ_OFFSET_HOURS=9

# Cho phép thêm trang web ở miền khác gọi API (cách nhau bằng dấu phẩy). localhost luôn được phép.
# CORS_ORIGINS=https://bibifood.github.io
